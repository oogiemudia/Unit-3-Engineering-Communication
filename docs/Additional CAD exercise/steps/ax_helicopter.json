{
 "name": "ax_helicopter",
 "title": "Light helicopter (concept)",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Fuselage: pod",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "File > New > Standard (mm).ipt and save it as fuselage.ipt.",
    "Sketch half the fuselage outline on the XZ Plane (nose arc, 1600 diameter cabin, tapering tail cone), 4100 long. Revolve about its axis."
   ],
   "note": null,
   "parts": [
    {
     "name": "fuselage",
     "colour": "#D9DDE2",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_01.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_01.json"
  },
  {
   "n": 2,
   "title": "Fuselage: canopy cut",
   "command": "3D Model tab > Modify panel > Split",
   "actions": [
    "Split the nose with a Work Plane 150 below the axis and a sloping plane at the windscreen pillar. Keep the rear: the glazing is its own part.",
    "Save fuselage.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "fuselage",
     "colour": "#D9DDE2",
     "new": false,
     "added": false,
     "removed": true
    }
   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_02.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_02.json"
  },
  {
   "n": 3,
   "title": "Canopy glazing: canopy",
   "command": "3D Model tab > Modify panel > Split",
   "actions": [
    "File > New > Standard (mm).ipt and save it as canopy.ipt.",
    "The nose taken from the split: Save As canopy.ipt.",
    "Save canopy.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "canopy glazing",
     "colour": "#9CC8E6",
     "new": true,
     "added": false,
