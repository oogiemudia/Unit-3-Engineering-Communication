   "title": "Horizontal stabiliser: stabiliser",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as stabiliser.ipt.",
    "Sketch a 420 x 1600 rectangle across the top of the boom. Extrude 40. Add the two end plates. Cut it to the boom (Extrude, Cut, To the boom surface).",
    "Save stabiliser.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "horizontal stabiliser",
     "colour": "#E8A33D",
