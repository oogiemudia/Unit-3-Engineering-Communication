    }
   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_03.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_03.json"
  },
  {
   "n": 4,
   "title": "Engine cowling: cowling",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as cowling.ipt.",
    "Sketch a slot 1200 x 900 on a Work Plane 600 above the axis. Extrude 420. Fillet the top R140. Add the 260 exhaust at the back.",
    "Save cowling.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "engine cowling",
     "colour": "#B9C0C8",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_04.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_04.json"
  },
  {
   "n": 5,
   "title": "Tail boom: boom",
   "command": "3D Model tab > Create panel > Loft",
   "actions": [
    "File > New > Standard (mm).ipt and save it as tail_boom.ipt.",
    "Loft from a 480 circle at the cabin to a 230 circle at the fin.",
    "Save tail_boom.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "tail boom",
     "colour": "#D9DDE2",
     "new": true,
     "added": false,
     "removed": false
