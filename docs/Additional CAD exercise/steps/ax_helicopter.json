{
 "name": "ax_helicopter",
 "title": "Light helicopter (concept)",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Fuselage: sketch the side profile",
   "command": "3D Model tab > Sketch panel > Start 2D Sketch",
   "actions": [
    "File > New > Standard (mm).ipt and save it as fuselage.ipt.",
    "Start 2D Sketch on the XZ Plane. Draw half the fuselage outline above a horizontal centre line 1400 up: the nose arc (three point arc through 420 x 120 to 650 x 520), the 1600 diameter cabin (a line 800 above the axis from 1300 to 2700) and the tail cone arc closing at 4100.",
    "Finish Sketch."
   ],
   "note": "Proportions only: the sketch has no usable sizes, so the cabin is sized for a light helicopter (1.6 m wide).",
   "parts": [],
   "overlay": true,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_01.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_01.json"
  },
  {
   "n": 2,
   "title": "Fuselage: revolve the pod",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "Revolve the profile 360 degrees about the centre line."
   ],
   "note": null,
   "parts": [
    {
     "name": "fuselage",
     "colour": "#D9DDE2",
