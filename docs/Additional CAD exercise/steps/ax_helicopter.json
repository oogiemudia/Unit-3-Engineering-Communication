   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_05.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_05.json"
  },
  {
   "n": 6,
   "title": "Fin and fan duct: duct and fin",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as fin.ipt.",
    "Sketch a 1040 ring (800 inside) on the XZ Plane at the end of the boom: Extrude 240. Sketch the swept fin above and the small fin below: Extrude 90 and 70.",
    "Save fin.ipt."
   ],
   "note": "A fan in a duct (a shrouded tail rotor) is quieter and safer on the ground than an open tail rotor.",
   "parts": [
    {
     "name": "fin and fan duct",
     "colour": "#E8A33D",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "Additional CAD exercise/steps/ax_helicopter/step_06.glb",
   "edges": "Additional CAD exercise/steps/ax_helicopter/step_06.json"
  },
  {
