   "edges": "ESP 2023/steps/esp2023_gate_leaf/step_02.json"
  },
  {
   "n": 3,
   "title": "Place the eight girders",
   "command": "Assemble tab > Pattern panel > Pattern",
   "actions": [
    "Place girder.ipt between the posts: Mate the ends to the post faces and Flush the flange with the downstream face.",
    "Offset its centre 150 mm above the base. Then place seven more at 800, 1450, 2150, 2900, 3750, 4700, 5860 mm (or Pattern with the levels typed in)."
   ],
   "note": "The girders are closer together near the bottom because the water pressure grows with depth: p = 1000 x 9.81 x depth.",
