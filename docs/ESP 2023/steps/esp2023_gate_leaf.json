{
 "name": "esp2023_gate_leaf",
 "title": "ESP 2023 gate leaf",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Place the heel post",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as gate_leaf.iam.",
    "Place heel_post.ipt, right click and choose Place Grounded at Origin. Its origin is the pivot axis, so the whole leaf is built from the hinge."
   ],
   "note": "Make the leaf a weldment: Environments tab > Convert to Weldment, so the welds and the welded parts are kept together.",
   "parts": [
    {
     "name": "heel post",
     "colour": "#4F6D7A",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "ESP 2023/steps/esp2023_gate_leaf/step_01.glb",
   "edges": "ESP 2023/steps/esp2023_gate_leaf/step_01.json"
  },
  {
   "n": 2,
   "title": "Place the mitre post",
   "command": "Assemble tab > Relationships panel > Constrain",
   "actions": [
    "Place mitre_post.ipt. Constrain > Flush its bottom with the heel post bottom (50 mm above the cill).",
    "Mate its back face 1760 mm from the heel post face (Mate with offset), and Flush the front faces."
   ],
   "note": null,
   "parts": [
    {
     "name": "heel post",
     "colour": "#4F6D7A",
     "new": false,
     "added": false,
     "removed": false
    },
    {
     "name": "mitre post",
     "colour": "#4F6D7A",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
