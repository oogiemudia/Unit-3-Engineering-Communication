{
 "name": "esp2023_lock_gates",
 "title": "ESP 2023 lock gates (GA)",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Lay out the lock and the chambers",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as esp2023_lock_gates.iam.",
    "Place inspection_chamber.ipt and right click, Place Grounded. Place a second copy for the other side.",
    "The lock walls are 4200 apart. Each chamber starts 300 mm behind the pivot, and is 2350 x 1800 x 1000 deep with 150 mm walls, a slot for the actuator rod and a plinth for the actuator pivot."
   ],
   "note": "The drive goes in a purpose-built chamber beside each gate, out of sight under a grating cover (left off here so you can see in).",
   "parts": [
    {
     "name": "left inspection chamber",
     "colour": "#B5B0A6",
     "new": true,
     "added": false,
     "removed": false
    },
    {
     "name": "right inspection chamber",
     "colour": "#B5B0A6",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "ESP 2023/steps/esp2023_lock_gates/step_01.glb",
   "edges": "ESP 2023/steps/esp2023_lock_gates/step_01.json"
  },
  {
   "n": 2,
   "title": "Place the hinges",
   "command": "Assemble tab > Relationships panel > Constrain",
   "actions": [
    "Place bottom_pintle.ipt twice and anchor_collar.ipt twice.",
    "The pivot axes are 2349 mm each side of the lock centre line, in the hollow quoins.",
    "Constrain > Mate each pintle axis to the collar axis above it, and Flush the pintle base with the cill (Z = 0)."
   ],
   "note": "The bottom pintle takes the weight of the leaf. The anchor collar at the top stops the leaf toppling forwards.",
   "parts": [
    {
     "name": "left inspection chamber",
     "colour": "#B5B0A6",
     "new": false,
     "added": false,
     "removed": false
    },
    {
     "name": "right inspection chamber",
     "colour": "#B5B0A6",
     "new": false,
