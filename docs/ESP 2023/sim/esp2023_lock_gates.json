 "steps": [
  {
   "view": "model",
   "title": "Open the Dynamic Simulation environment",
   "command": "Environments tab > Begin panel > Dynamic Simulation",
   "actions": [
    "Open esp2023_lock_gates.iam in Inventor.",
    "Click the Environments tab, then Dynamic Simulation."
   ],
   "note": "Dynamic Simulation works out how an assembly moves, and the forces and speeds as it moves."
  },
  {
   "view": "joints",
   "title": "Turn constraints into joints",
   "command": "Dynamic Simulation tab > Manage panel > Simulation Settings",
   "actions": [
    "Click Simulation Settings and tick Automatically convert constraints to standard joints. Click OK.",
    "Open Standard Joints in the browser to see the joints Inventor made from your assembly constraints."
   ],
   "note": "Parts held together with no movement between them become one rigid group, listed under Welded group."
  },
  {
   "view": "joints",
   "title": "Check the hinge joints",
   "command": "Dynamic Simulation tab > Joint panel > Insert Joint",
   "actions": [
    "In Standard Joints find the Revolution joint for each leaf: the heel post journal in the anchor collar, and the heel post bore on the bottom pintle.",
    "If a leaf has two joints (one at the top and one at the bottom) Inventor shows the second as redundant. Keep one Revolution joint per leaf, on the pivot axis, and delete the other.",
    "Each leaf, with its fenders, seals and walkway, should be one Welded group."
   ],
   "note": "A revolution joint lets a part turn about one axis and nothing else: one degree of freedom."
  },
  {
   "view": "joints",
   "title": "Join the actuators",
   "command": "Dynamic Simulation tab > Joint panel > Insert Joint",
   "actions": [
    "Each actuator needs three joints. Insert Joint, Revolution: the actuator body rear pivot on the plinth axis.",
    "Insert Joint, Cylindrical: the rod inside the body bore, so the rod can slide out.",
    "Insert Joint, Spherical: the rod eye centre on the leaf bracket."
   ],
   "note": "The rod eye is a spherical bearing, so the actuator can follow the leaf as it swings."
  },
  {
   "view": "motion",
   "title": "Drive the leaves",
   "command": "Right click a leaf Revolution joint > Properties > dof 1 (R) > Edit imposed motion",
   "actions": [
    "Tick Enable imposed motion. Drive: Position.",
    "Right leaf, in the Input Grapher: 0 degrees at 1 s, -71.6 degrees (fully open) at 7 s, hold to 9 s, back to 0 at 15 s.",
    "Left leaf: the same, but +71.6 degrees, starting half a second later, so you can see the leaves work independently.",
    "Click OK twice."
   ],
   "note": "The real gates take about 60 s to open. This simulation runs 10 times faster. Each leaf turns 71.6 degrees, from the mitre (1 in 3) into its recess in the lock wall."
  },
  {
   "view": "motion",
   "title": "Check the actuator stroke",
   "command": "Dynamic Simulation tab > Joint panel > Insert Joint",
   "actions": [
    "Right click the actuator Cylindrical joint > Properties and look at dof 2 (T): Inventor works out how far the rod slides as the leaf turns.",
    "Pin to pin length: 3301 mm with the gate shut and 2045 mm with it open, a stroke of 1256 mm.",
    "Check the rod never pulls out of the body: at full length 199 mm of the rod is still inside."
   ],
   "note": "Choose an actuator with at least this stroke. A 1300 mm stroke electric actuator gives some spare."
  },
