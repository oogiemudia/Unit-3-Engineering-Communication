 "steps": [
  {
   "view": "model",
   "title": "Open the Dynamic Simulation environment",
   "command": "Environments tab > Begin panel > Dynamic Simulation",
   "actions": [
    "Open toggle_clamp.iam in Inventor.",
    "Click the Environments tab, then Dynamic Simulation."
   ],
   "note": "Dynamic Simulation works out how an assembly moves, and the forces and speeds as it moves."
  },
  {
   "view": "joints",
   "title": "Turn constraints into joints",
   "command": "Dynamic Simulation tab > Manage panel > Simulation Settings",
   "actions": [
    "Click Simulation Settings and tick Automatically convert constraints to standard joints. Click OK.",
    "Open Standard Joints in the browser to see the joints Inventor made from your assembly constraints."
   ],
   "note": "Parts held together with no movement between them become one rigid group, listed under Welded group."
  },
  {
   "view": "joints",
   "title": "Check the four pin joints",
   "command": "Dynamic Simulation tab > Joint panel > Insert Joint",
   "actions": [
    "Standard Joints should list four Revolution joints: base to arm, base to handle, arm to link, link to handle.",
    "The spindle, nuts and pad are Welded to the arm; the grip to the handle."
   ],
   "note": "Base, arm, link and handle make a four bar linkage: one input (the handle) sets where everything else is."
  },
  {
   "view": "motion",
   "title": "Drive the arm",
   "command": "Right click the base to arm Revolution joint > Properties > dof 1 (R) > Edit imposed motion",
   "actions": [
    "Tick Enable imposed motion. Drive: Position.",
    "Input Grapher: 0 at 0.5 s, 20 degrees at 3 s, held to 4.5 s, 0 at 7 s."
   ],
   "note": "In use you push the handle; driving the arm here keeps the linkage on the same branch through the dead centre."
  },
  {
   "view": "play",
   "title": "Run the simulation",
   "command": "Dynamic Simulation tab > Manage panel > Simulation Player",
   "actions": [
    "In the Simulation Player set Final Time to 8 s and Images to 400.",
    "Click Run. The assembly moves and the timeline fills in.",
    "Use the slider to scrub back and forth."
   ],
   "note": "Press Play below to run the same motion here."
  },
  {
   "view": "graph",
   "title": "Plot the results",
   "command": "Dynamic Simulation tab > Results panel > Output Grapher",
   "actions": [
    "Open the Output Grapher.",
    "Under Standard Joints, tick the angles of the arm and handle Revolution joints.",
    "The graph shows each value against time. Click on the graph to move the simulation to that moment."
   ],
   "note": null
  },
  {
   "view": "graph",
   "title": "Record a video",
   "command": "Dynamic Simulation tab > Manage panel > Simulation Player",
   "actions": [
    "In the Simulation Player click Record (the red dot) and choose a file name and format.",
    "Click Run again. Inventor saves a video of the motion for your portfolio."
   ],
   "note": "You can also export a moment to Stress Analysis (Export to FEA) to check a part at its highest load."
  }
 ]
}