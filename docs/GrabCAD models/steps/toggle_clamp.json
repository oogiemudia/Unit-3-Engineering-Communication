   "title": "Base: base plate",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as base.ipt.",
    "Sketch a 75 x 40 rectangle on the XZ Plane (the ground). Extrude 4 mm. Fillet the corners 5 mm."
   ],
   "note": null,
   "parts": [
    {
     "name": "base",
     "colour": "#5B8DEF",
     "new": true,
     "added": false,
