{
 "name": "plummer_block",
 "title": "Plummer block bearing",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Housing base: sketch the foot",
   "command": "3D Model tab > Sketch panel > Start 2D Sketch",
   "actions": [
    "File > New > Standard (mm).ipt and save it as housing_base.ipt.",
    "Start 2D Sketch on the XZ Plane (the ground). Rectangle (Two Point Center) 240 x 55 on the origin.",
    "Finish Sketch."
   ],
   "note": null,
   "parts": [],
   "overlay": true,
   "glb": "GrabCAD models/steps/plummer_block/step_01.glb",
   "edges": "GrabCAD models/steps/plummer_block/step_01.json"
  },
  {
   "n": 2,
   "title": "Housing base: extrude the foot, body and lugs",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "Extrude the foot 20 mm upwards.",
    "Sketch on its top: a rectangle 110 x 60 (the body) and one 190 x 44 (the stud lugs), both centred. Extrude them 45 mm, Join, so the split line is 65 mm (the shaft centre height) above the base."
   ],
   "note": null,
   "parts": [
    {
     "name": "housing base",
     "colour": "#6E7F99",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/plummer_block/step_02.glb",
   "edges": "GrabCAD models/steps/plummer_block/step_02.json"
  },
  {
   "n": 3,
   "title": "Housing base: the bore",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "Sketch on the XY Plane (the front, through the shaft axis) the half section of the bore: bearing seat 80 diameter x 18 wide, grease space 60 x 28, shaft clearance 42, two felt seal grooves 54 x 6 at 20 to 26 from the middle.",
    "Revolve it about the shaft axis, Cut. The upper half cuts nothing, because the base stops at the split line."
   ],
   "note": "The bore is cut in both halves with the same sketch, as the halves are machined together.",
   "parts": [
    {
     "name": "housing base",
     "colour": "#6E7F99",
     "new": false,
     "added": false,
     "removed": true
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/plummer_block/step_03.glb",
   "edges": "GrabCAD models/steps/plummer_block/step_03.json"
  },
  {
   "n": 4,
   "title": "Housing base: slots for the holding down bolts",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "Sketch on the top of the foot: two Slots (Center to Center) 12 long x 14 wide, 105 each side of the middle.",
    "Extrude, Cut, Through All."
   ],
   "note": "Slots let the block slide along to line the shaft up before the bolts are tightened.",
   "parts": [
    {
     "name": "housing base",
     "colour": "#6E7F99",
     "new": false,
     "added": false,
     "removed": true
    }
   ],
