  },
  {
   "n": 2,
   "title": "Body: set screw hole",
   "command": "3D Model tab > Modify panel > Hole",
   "actions": [
    "Hole on the side of the boss, 10 below the top: Tapped M8x1.25, into the nut bore."
   ],
   "note": null,
   "parts": [
    {
     "name": "body",
     "colour": "#6E7F99",
