  {
   "n": 1,
   "title": "Body: revolve the body",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "File > New > Standard (mm).ipt and save it as body.ipt.",
    "Sketch the half section on the XY Plane: base 120 diameter x 15, tapering to 64 at 100 high, a 70 x 20 boss on top; inside, a 56 bore 30 deep for the nut and a 38 bore below. Revolve 360."
   ],
   "note": null,
   "parts": [
    {
     "name": "body",
     "colour": "#6E7F99",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
