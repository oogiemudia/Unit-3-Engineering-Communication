  },
  {
   "n": 7,
   "title": "Fork: axle hole",
   "command": "3D Model tab > Modify panel > Hole",
   "actions": [
    "Hole through both legs at the axle: diameter 10.5, Through All.",
    "Save fork.ipt."
   ],
   "note": "The axle is 35 mm behind the swivel axis, so the wheel trails behind and lines itself up with the direction of travel.",
   "parts": [
    {
     "name": "fork",
