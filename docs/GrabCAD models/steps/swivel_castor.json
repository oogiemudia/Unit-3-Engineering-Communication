{
 "name": "swivel_castor",
 "title": "Swivel castor",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Top plate: square plate",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as top_plate.ipt.",
    "Sketch a 90 x 90 square on the XZ Plane, Extrude 4 mm. Fillet the corners 8 mm."
   ],
   "note": null,
   "parts": [
    {
     "name": "top plate",
     "colour": "#5B8DEF",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/swivel_castor/step_01.glb",
   "edges": "GrabCAD models/steps/swivel_castor/step_01.json"
  },
  {
   "n": 2,
   "title": "Top plate: ball track",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "Sketch a 6 mm circle on a 60 mm pitch diameter, 1.5 below the plate. Revolve, Cut."
   ],
   "note": "In the factory the track is pressed into the plate, not cut.",
   "parts": [
    {
     "name": "top plate",
     "colour": "#5B8DEF",
     "new": false,
     "added": false,
     "removed": true
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/swivel_castor/step_02.glb",
   "edges": "GrabCAD models/steps/swivel_castor/step_02.json"
  },
  {
   "n": 3,
   "title": "Top plate: holes",
   "command": "3D Model tab > Modify panel > Hole",
   "actions": [
    "Hole diameter 10 in the middle (king pin). Holes diameter 9 for the M8 fixing bolts, on a 70 x 70 square.",
    "Save top_plate.ipt."
   ],
   "note": null,
   "parts": [
    {
     "name": "top plate",
     "colour": "#5B8DEF",
     "new": false,
     "added": false,
     "removed": true
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/swivel_castor/step_03.glb",
   "edges": "GrabCAD models/steps/swivel_castor/step_03.json"
  },
  {
   "n": 4,
   "title": "Fork: crown",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "File > New > Standard (mm).ipt and save it as fork.ipt.",
    "Sketch an 80 diameter circle with a 49 x 48 tab towards the axle. Extrude 6 mm."
   ],
   "note": null,
   "parts": [
    {
     "name": "fork",
     "colour": "#5B8DEF",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "GrabCAD models/steps/swivel_castor/step_04.glb",
   "edges": "GrabCAD models/steps/swivel_castor/step_04.json"
  },
  {
   "n": 5,
   "title": "Fork: legs",
   "command": "3D Model tab > Create panel > Extrude",
   "actions": [
    "Sketch the leg on the XY Plane, 24 wide with a 12 radius end round the axle. Extrude 4 mm, 20 out from the middle, Join. Mirror it."
   ],
   "note": null,
   "parts": [
    {
     "name": "fork",
     "colour": "#5B8DEF",
     "new": false,
     "added": true,
     "removed": false
    }
