   "edges": "GrabCAD models/steps/swivel_castor/step_05.json"
  },
  {
   "n": 6,
   "title": "Fork: ball track and king pin hole",
   "command": "3D Model tab > Create panel > Revolve",
   "actions": [
    "Revolve Cut the 6 mm track (60 pitch diameter) in the top of the crown. Hole 10 in the middle."
   ],
   "note": null,
   "parts": [
    {
     "name": "fork",
     "colour": "#5B8DEF",
     "new": false,
     "added": false,
     "removed": true
