{
 "name": "esp2026_single_seat",
 "title": "ESP 2026 single seat",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Seat pan and cushion",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as single_seat.iam.",
    "Place seat_diaphragm.ipt, right click and Place Grounded. In the set it sits on the beam tubes, 355 mm up.",
    "Place seat_foam.ipt and Mate its bottom to the top of the diaphragm. Place seat_cover.ipt over the foam: Mate the inside faces of the cover to the foam."
   ],
   "note": "The seat height is the top of the cover at the front edge: 440 mm above the floor.",
   "parts": [
    {
     "name": "diaphragm",
     "colour": "#2B2B2B",
     "new": true,
     "added": false,
     "removed": false
    },
    {
     "name": "cushion foam",
     "colour": "#E8D9A8",
     "new": true,
     "added": false,
     "removed": false
    },
    {
     "name": "cushion cover",
     "colour": "#1F3A5F",
     "new": true,
     "added": false,
     "removed": false
    }
   ],
   "overlay": false,
   "glb": "ESP 2026/steps/esp2026_single_seat/step_01.glb",
   "edges": "ESP 2026/steps/esp2026_single_seat/step_01.json"
  },
  {
   "n": 2,
   "title": "Place the back shell",
   "command": "Assemble tab > Relationships panel > Constrain",
   "actions": [
    "Place back_shell.ipt. Constrain > Insert is not possible without the spreaders, so in this sub-assembly use Angle: 12 degrees between the back and the vertical, and Mate the pivot axis 420 mm aft and 390 mm up."
   ],
   "note": "In the three-seat set the back pivots on the spreader pins. Suppress the Angle constraint to let it recline.",
   "parts": [
    {
     "name": "diaphragm",
     "colour": "#2B2B2B",
