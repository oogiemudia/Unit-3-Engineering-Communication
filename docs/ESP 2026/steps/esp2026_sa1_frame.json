   "n": 1,
   "title": "Place the legs",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as frame.iam.",
    "Place leg.ipt and Place Grounded. Place a second leg 540 mm along X (Mate the faces to the work plane with an offset of 270 each side of the centre)."
