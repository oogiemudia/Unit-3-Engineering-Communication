{
 "name": "esp2024_sa1_float",
 "title": "ESP 2024 sub-assembly 1: float",
 "software": "Autodesk Inventor",
 "steps": [
  {
   "n": 1,
   "title": "Hull and foam",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as float.iam.",
    "Place float_hull.ipt and Place Grounded.",
    "Place float_foam.ipt and Mate its outside to the inside of the shell (it fills it exactly)."
   ],
   "note": "At the factory the foam is poured into the shell through a filling hole.",
   "parts": [
    {
     "name": "float hull",
     "colour": "#C8372D",
     "new": true,
     "added": false,
     "removed": false
    },
    {
