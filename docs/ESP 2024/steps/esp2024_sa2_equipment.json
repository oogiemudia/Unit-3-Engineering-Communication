   "n": 1,
   "title": "Canister",
   "command": "Assemble tab > Component panel > Place",
   "actions": [
    "File > New > Standard (mm).iam and save it as equipment_canister.iam.",
    "Place canister.ipt and Place Grounded."
   ],
